    "postinstall": "GIT_CEILING_DIRECTORIES=\"$(dirname \"$PWD\")\" git apply --reverse --check patches/deepmerge+4.3.1.patch 2>/dev/null || GIT_CEILING_DIRECTORIES=\"$(dirname \"$PWD\")\" git apply patches/deepmerge+4.3.1.patch"
